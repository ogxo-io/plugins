{
  "name": "thryx",
  "version": "0.1.3",
  "description": "Thryx project management over MCP: issues, projects, cycles, milestones, and documents in your Thryx workspace.",
  "author": { "name": "ogxo", "url": "https://github.com/ogxo-io" },
  "homepage": "https://app.thryx.io",
  "license": "MIT",
  "keywords": ["mcp", "project-management", "issues", "sprints", "planning"],
  "mcpServers": {
    "thryx": {
      "type": "http",
      "url": "https://app.thryx.io/api/v1/mcp/${THRYX_WORKSPACE}",
      "headers": { "Authorization": "Bearer ${THRYX_TOKEN}" }
    }
  }
}
